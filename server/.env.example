# Copie este arquivo para ".env" (na pasta server) e ajuste.
PORT=5000

# ---------- LOGIN / SEGURANÇA ----------
# Segredo que assina as sessões (cookie). OBRIGATÓRIO em produção: use um texto longo e aleatório.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Senha do administrador. Se a conta admin ainda estiver com a senha de demonstração (123456),
# ela é trocada por esta no próximo início do servidor (mínimo 8 caracteres).
ADMIN_PASSWORD=

# Quantos proxies existem na frente do servidor (Render/Railway/Fly = 1). Use 0 se acessar direto.
TRUST_PROXY=1

# Só preencha se o site (front-end) ficar em OUTRO endereço que a API. Lista separada por vírgula.
# Padrão (recomendado): site e API no mesmo endereço, sem CORS.
# ALLOWED_ORIGINS=https://www.seudominio.com

# ---------- PAGAMENTOS ----------
# A recarga PIX atual é SIMULADA (credita sem cobrar). Ao integrar um gateway real, desligue:
# PAYMENT_SIMULATION=off

# ---------- CHAMADAS ----------
# Quanto tempo a chamada toca para o oraculista antes de virar "não atendida" (milissegundos)
RING_TIMEOUT_MS=45000

# TURN: necessário para as chamadas funcionarem quando alguém usa 4G/5G ou redes corporativas.
# Serviços gratuitos/baratos: Metered, Twilio, Cloudflare Calls, ou seu próprio servidor coturn.
# TURN_URL=turn:seu-servidor.com:3478,turns:seu-servidor.com:5349
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
